[Unit]
Description=Gerenciador Web Raspberry PI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=administrador
Group=administrador
WorkingDirectory=/home/administrador/raspberry-pi-manager
EnvironmentFile=/etc/default/raspberry-pi-manager
ExecStart=/home/administrador/raspberry-pi-manager/venv/bin/python /home/administrador/raspberry-pi-manager/src/app.py
# Ao parar o serviço (inclusive durante desligamento/reinício), encerra o kiosk
# do Chromium de forma limpa: SIGTERM e, se persistir, SIGKILL.
ExecStop=-/bin/bash -c 'pkill -TERM -f chromium 2>/dev/null; sleep 2; pkill -KILL -f chromium 2>/dev/null; true'
TimeoutStopSec=15
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=raspberry-pi-manager

# Segurança / sandboxing
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/administrador/raspberry-pi-manager /home/administrador/chromium-profile /home/administrador/.config/raspberry-pi-manager
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Ambiente mínimo
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONUNBUFFERED=1"

# NOTA: este arquivo é uma REFERÊNCIA. O install.sh gera um unit equivalente
# automaticamente. Mantenha os dois alinhados (ExecStart, EnvironmentFile,
# ReadWritePaths) — ver contrato C7 em CLAUDE.md.

[Install]
WantedBy=multi-user.target
