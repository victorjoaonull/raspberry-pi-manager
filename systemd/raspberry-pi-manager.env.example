# Example environment file for raspberry-pi-manager
# Copy to /etc/default/raspberry-pi-manager and edit values before starting the service

# Secret used to validate GitHub webhook HMAC
WEBHOOK_SECRET=602d5122f688294d2155c7766df73588cd25c6333f056acc58e9f10c425dd17a

# Optional: name of systemd service to restart after update (used by update_app.sh)
SERVICE_NAME=raspberry-pi-manager

# Install path — used when update_app.sh runs from /usr/local/bin (must match sudoers systemctl line)
#APP_INSTALL_DIR=/home/administrador/raspberry-pi-manager

# Optional: other env vars
#DEBUG=false
#FLASK_HOST=0.0.0.0
#FLASK_PORT=5000
