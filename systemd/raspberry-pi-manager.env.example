# Example environment file for raspberry-pi-manager
# Copy to /etc/default/raspberry-pi-manager and edit values before starting the service

# Secret used to validate GitHub webhook HMAC
WEBHOOK_SECRET=602d5122f688294d2155c7766df73588cd25c6333f056acc58e9f10c425dd17a

# Flask session signing — install.sh generates if missing; keep secret and stable in production
#FLASK_SECRET_KEY=generate_with_openssl_rand_hex_32

# Diagnostic JSON routes (/api/diagnostic/*, /api/favorites/diagnostic): off unless true
#PI_MANAGER_DIAGNOSTICS=true

# Login brute-force mitigation (defaults: limit on, 8 fails / 900s window, 600s lockout)
#PI_MANAGER_LOGIN_RATE_LIMIT=1
#PI_MANAGER_LOGIN_MAX_FAILS=8
#PI_MANAGER_LOGIN_WINDOW_SEC=900
#PI_MANAGER_LOGIN_LOCKOUT_SEC=600
# Behind trusted reverse proxy only:
#PI_MANAGER_TRUST_PROXY=true

# Optional: name of systemd service to restart after update (used by update_app.sh)
SERVICE_NAME=raspberry-pi-manager

# Install path — used when update_app.sh runs from /usr/local/bin (must match sudoers systemctl line).
# Also used by the webhook to allow running update_app.sh from custom install dirs.
#APP_INSTALL_DIR=/home/administrador/raspberry-pi-manager

# Optional: same as APP_INSTALL_DIR (webhook allowlist); prefer APP_INSTALL_DIR for consistency
#PI_MANAGER_INSTALL_DIR=/home/administrador/raspberry-pi-manager

# Chromium profile directory (--user-data-dir). Default: /home/administrador/chromium-profile
# Use a new path (e.g. .../chromium-profile-padrao) after hostname/image changes to avoid SingletonLock issues.
#PI_MANAGER_CHROMIUM_USER_DATA_DIR=/home/administrador/chromium-profile

# App file logs (browser-launch, etc.). Default: <install_dir>/logs
#PI_MANAGER_LOG_DIR=/home/administrador/raspberry-pi-manager/logs

# Session cookies (behind HTTPS reverse proxy use SESSION_COOKIE_SECURE=true)
#SESSION_COOKIE_SECURE=true
#SESSION_COOKIE_SAMESITE=Lax

# PAM login: Linux user whose password is checked (default: administrador)
#PI_MANAGER_PAM_USER=administrador

# PAM service stack to try, comma-separated (default: login,sshd,su,sudo)
#PI_MANAGER_PAM_SERVICES=login,su,sudo

# Debug: imprimir traceback no journal para exceções tratadas (Chromium, singleton, etc.)
#PI_MANAGER_DEBUG_TRACEBACK=true

# Journal / terminal sem emoji nos eventos do painel (add_event) e alguns prints
#PI_MANAGER_ASCII_LOGS=true

# Optional: if set, GET /api/health returns 404 unless header matches (protege dados de diagnostico)
#PI_MANAGER_HEALTH_SECRET=coloque_um_segredo_longo_aqui
# curl -H "X-Health-Secret: coloque_um_segredo_longo_aqui" http://127.0.0.1:5000/api/health

# update_app.sh: exit 1 if PAM import fails after update (optional strict mode)
#UPDATE_APP_STRICT_PAM=1

# Auto-update pull (cada Raspberry verifica updates periodicamente via systemd timer)
PI_MANAGER_AUTO_UPDATE_ENABLED=1
#PI_MANAGER_AUTO_UPDATE_BRANCH=main
#PI_MANAGER_AUTO_UPDATE_REMOTE=origin

# Optional: other env vars
#DEBUG=false
#FLASK_HOST=0.0.0.0
#FLASK_PORT=5000
