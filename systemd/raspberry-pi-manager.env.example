# Example environment file for raspberry-pi-manager
# Copy to /etc/default/raspberry-pi-manager and edit values before starting the service

# Secret used to validate GitHub webhook HMAC
WEBHOOK_SECRET=602d5122f688294d2155c7766df73588cd25c6333f056acc58e9f10c425dd17a

# Optional: name of systemd service to restart after update (used by update_app.sh)
SERVICE_NAME=raspberry-pi-manager

# Install path — used when update_app.sh runs from /usr/local/bin (must match sudoers systemctl line).
# Also used by the webhook to allow running update_app.sh from custom install dirs.
#APP_INSTALL_DIR=/home/administrador/raspberry-pi-manager

# Optional: same as APP_INSTALL_DIR (webhook allowlist); prefer APP_INSTALL_DIR for consistency
#PI_MANAGER_INSTALL_DIR=/home/administrador/raspberry-pi-manager

# Chromium profile directory (--user-data-dir). Default: /home/administrador/chromium-profile
# Use a new path (e.g. .../chromium-profile-padrao) after hostname/image changes to avoid SingletonLock issues.
#PI_MANAGER_CHROMIUM_USER_DATA_DIR=/home/administrador/chromium-profile

# App file logs (browser-launch, etc.). Default: <install_dir>/logs
#PI_MANAGER_LOG_DIR=/home/administrador/raspberry-pi-manager/logs

# Session cookies (behind HTTPS reverse proxy use SESSION_COOKIE_SECURE=true)
#SESSION_COOKIE_SECURE=true
#SESSION_COOKIE_SAMESITE=Lax

# Optional: other env vars
#DEBUG=false
#FLASK_HOST=0.0.0.0
#FLASK_PORT=5000
