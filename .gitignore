__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Logs and runtime files
*.log
update_app.log

# Configuração de runtime (URLs salvas pelo usuário). NÃO versionar:
